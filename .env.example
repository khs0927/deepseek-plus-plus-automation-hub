# DeepSeek++ private integration environment template.
# Copy to .env only for local use. Never commit .env or real credentials.

# --- DeepSeek++ / Native Host ---
DPP_LOG_FILE=
DPP_OFFICECLI_INSTALL_DIR=
DPP_FOLDER_PICK_TITLE=Select a folder
DPP_FOLDER_PICK_DEFAULT_PATH=
DEEPSEEK_PP_UPDATE_PROMPT_GOLDENS=false
OFFICECLI_SKIP_UPDATE=1

# --- GitHub operations ---
# Prefer gh auth login / OS keyring. Never commit a real token.
GH_TOKEN=
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- MCP provider credentials (names discovered from the local MCP registry) ---
DOPPLER_TOKEN=
EXA_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=
VWORLD_API_KEY=
BLDRGST_SERVICE_KEY=
ARCHPMS_SERVICE_KEY=
HSPMS_SERVICE_KEY=
LAW_OC=
FREECAD_PATH=
RHINO_HOST=
RHINO_PORT=
RHINO_FULL_CONFIG=
RHINO_MCP_HOST=
RHINO_MCP_LOG_LEVEL=
RHINO_MCP_TRANSPORT=
RHINO_MCP_TRANSPORT_KIND=
FASTMCP_LOG_LEVEL=
FASTMCP_SHOW_SERVER_BANNER=
LOG_LEVEL=
PYTHONIOENCODING=UTF-8
PYTHONUNBUFFERED=1

# --- Seumter / Edge CDP integration ---
SEUMTER_MCP_PORT=3300
CDP_URL=http://127.0.0.1:9222
EDGE_CDP_URL=http://127.0.0.1:9222
EDGE_PORT=9222
EDGE_USER_DATA_DIR=C:\edge_dev
EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
SEUMTER_PROJECT_CONFIG=src/config/project_template.json
SEUMTER_TARGET_DIR=
SEUMTER_DESKTOP_DIR=

# Windows runtime variables are inherited from the host and are intentionally
# not copied here: PATH, USERPROFILE, LOCALAPPDATA, ProgramFiles, TEMP, TMP.
